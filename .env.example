# Copy to .env (or just run `npm run setup`, which creates .env with random values).
# Never commit .env. Every value below is a placeholder.
COMPOSE_PROJECT_NAME=placegraph

# MySQL (host port 3308 avoids clashing with a local MySQL on 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=placegraph
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=placeapp
MYSQL_PASSWORD=change-me-app

# Neo4j
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# Web app
JWT_SECRET=change-me-at-least-32-characters-long
DEMO_OFFICER_PASSWORD=change-me-officer
DEMO_STUDENT_PASSWORD=change-me-student
